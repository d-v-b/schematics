# Dev actions for the bolt bar: a flat bar with slots for M6 bolts that sits
# on a 40 mm aluminium rail. Run `just` to list them.
#
# Run inside the pixi env (`pixi shell`) or via `pixi run <recipe>`.

python := env("PYTHON", "python")
out := "stl"

length := "200"     # along the rail, mm
pitch := "40"       # slot centre to centre, mm
slot_l := "30"      # slot length along the bar, mm; pitch - slot_l is left between slots
slot_w := "6.6"     # M6 clearance 6.4 + 0.2 print allowance
end_r := "40"       # radius of the arc capping each end, centred that far in from the tip; 0 = square
args := "--length " + length + " --pitch " + pitch + " --slot_l " + slot_l + " --slot_w " + slot_w + " --end_r " + end_r

default:
    @just --list

# Render the bar (.stl, .step or .svg) with any --param overrides, e.g. `just render out.stl --length 120`
[positional-arguments]
render outfile *args:
    {{python}} bolt_bar.py -o "$@"

# Render the bar with the values above
bar:
    just render "{{out}}/bolt_bar_L{{length}}_p{{pitch}}_s{{slot_l}}x{{slot_w}}_r{{end_r}}.stl" {{args}}

# Regenerate the drawing used by the README
preview:
    just render profile.svg {{args}}

# Run the geometry tests
test:
    {{python}} -m pytest -q

# Delete rendered output
clean:
    rm -rf {{out}}
