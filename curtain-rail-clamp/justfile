# Dev actions for the curtain rail clamp. Run `just` to list them.
#
# Values for the real part live at the top; edit them once a test print fits.

python := env("PYTHON", "python")
out := "stl"

tubes := "outer,outer"      # rail section under each C, left to right
spacing := "40"             # rail centre-to-centre, mm
wall := "1.2"               # C thickness, mm (the flex happens here)
opening := "16"             # gap between the lip tips, mm (rail is 19.5)
clearance := "0"            # cavity minus rail, mm (negative = squeeze)
length := "20"              # extent along the rails, mm
sweep_walls := "1.2 1.5"
sweep_openings := "17 16 15"
min_safety := "0.7"         # stress gate; the model has proved conservative for printed walls
args := "--tubes " + tubes + " --spacing " + spacing + " --length " + length + " --clearance " + clearance + " --min_safety " + min_safety

default:
    @just --list

# Render one clamp (.stl, .step or .svg) with any --param overrides
[positional-arguments]
render outfile *args:
    {{python}} rail_clip.py -o "$@"

# The clamp with the values above
clamp:
    just render "{{out}}/rail_clamp_{{tubes}}_s{{spacing}}_w{{wall}}_o{{opening}}_c{{clearance}}_L{{length}}.stl" \
        {{args}} --wall {{wall}} --opening {{opening}}

# Fit sweep over wall x opening (single outer-tube C, to print fast)
sweep:
    #!/usr/bin/env bash
    set -euo pipefail
    for w in {{sweep_walls}}; do
        for o in {{sweep_openings}}; do
            just render "{{out}}/clip_outer_w${w}_o${o}_c{{clearance}}.stl" --tubes outer --length {{length}} \
                --clearance {{clearance}} --min_safety {{min_safety}} --wall "$w" --opening "$o" \
                || echo "  skipped w$w o$o: does not validate"
        done
    done

# Regenerate the drawings used by the README
preview:
    {{python}} framfusig.py -o rail_profiles.svg
    just render clamp_profile.svg {{args}} --wall {{wall}} --opening {{opening}}

# Run the geometry tests
test:
    {{python}} -m pytest -q

# Delete rendered output
clean:
    rm -rf {{out}}
