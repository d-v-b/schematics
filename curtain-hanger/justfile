# Dev actions for the curtain hanger: a bolted beam wrap whose lower half carries
# the curtain rail clamps fused to its base, and their assembly. Run `just` to list them.
#
# Sweep and full-scale values live at the top of this file; edit them once you
# know what fits. Run inside the pixi env (`pixi shell`) or via `pixi run <recipe>`.

python := env("PYTHON", "python")
out := "stl"

# --- Rail clamps fused to the lower bolt half's base (the upper half is plain)
rails := "outer,outer"      # rail section under each C, left to right
rail_spacing := "40"        # rail centre-to-centre, mm
rail_wall := "2.0"          # C thickness, mm; 1.2 gripped too weakly on curtains
rail_opening := "10"        # gap between the lip tips, mm (rail is 19.5); 10 gripped best
rail_clearance := "0"       # cavity minus rail, mm (negative = squeeze)
fused_args := "--rails " + rails + " --rail_spacing " + rail_spacing + " --rail_wall " + rail_wall + " --rail_opening " + rail_opening + " --rail_clearance " + rail_clearance

# --- Clamp, phase 1: prototype sweep -------------------------------------
proto_walls := "2 3 4"              # wall thickness, mm
proto_clearances := "0.0 0.3 0.6"   # inner span minus beam width, mm
proto_length := "10"                # short parts print fast; fit is identical

# --- Clamp, phase 2: full-scale part --------------------------------------
full_wall := "3"
full_clearance := "0.3"
full_length := "40"

# --- Wrap: joint coupons and full halves ----------------------------------
coupon_clearances := "0.15 0.25 0.4"   # joint_clearance, mm
coupon_tooth_hs := "0.8 1.2"           # tooth_h, mm
coupon_length := "10"
wrap_wall := "3"
wrap_clearance := "0.3"
wrap_joint_clearance := "0.25"
wrap_length := "40"

# --- Bolt: joint coupons and full halves ----------------------------------
bolt_clearances := "0.2 0.3 0.5"       # joint_clearance between the finger faces, mm
bolt_coupon_length := "10"
bolt_wall := "5"
bolt_clearance := "0.3"
bolt_joint_clearance := "0.3"
bolt_length := "10"                    # 10 for the test print; 50 for the real part
bolt_args := "--wall " + bolt_wall + " --clearance " + bolt_clearance

# --- Flex: joint coupons and full halves ----------------------------------
flex_clearances := "-0.3 0.0 0.2"      # joint_clearance between the nested laps, mm (negative = preload)
flex_tooth_hs := "1.5 2.0"             # tooth_h, mm; 0.8 did not print
flex_coupon_length := "10"
flex_wall := "5"
flex_clearance := "0.3"
flex_joint_clearance := "-0.3"
flex_length := "10"                    # 10 for the test print; 50 for the real part
flex_args := "--wall " + flex_wall + " --clearance " + flex_clearance

# --- Stand-alone rail clamp (plate version, kept for reference and coupons)
rail_coupon_length := "3"           # fit-check coupons only need a few mm
rail_sweep_walls := "1.5 2.0"
rail_sweep_openings := "15 14 13 12 11 10"
rail_args := "--tubes " + rails + " --spacing " + rail_spacing + " --clearance " + rail_clearance + " --min_safety 0"

default:
    @just --list

# Render one clamp file (.stl, .step or .svg) with any --param overrides, e.g. `just render out.stl --wall 2`
[positional-arguments]
render outfile *args:
    {{python}} beam_clamp.py -o "$@"

# Render one wrap half (.stl, .step or .svg) with any --param overrides
[positional-arguments]
render-wrap outfile *args:
    {{python}} beam_wrap.py -o "$@"

# Render one bolted half (.stl, .step or .svg) with any --param overrides
[positional-arguments]
render-bolt outfile *args:
    {{python}} beam_bolt.py -o "$@"

# Render one flex half (.stl, .step or .svg) with any --param overrides
[positional-arguments]
render-flex outfile *args:
    {{python}} beam_flex.py -o "$@"

# Render one rail clamp (.stl, .step or .svg) with any --param overrides
[positional-arguments]
render-rail outfile *args:
    {{python}} rail_clamp.py -o "$@"

# Clamp phase 1: render the labelled fit-test sweep into {{out}}/
proto:
    #!/usr/bin/env bash
    set -euo pipefail
    for w in {{proto_walls}}; do
        for c in {{proto_clearances}}; do
            just render "{{out}}/proto_w${w}_c${c}.stl" \
                --wall "$w" --clearance "$c" --length {{proto_length}} --label "w$w c$c"
        done
    done

# Clamp phase 2: render the full-scale clamp with the chosen values
full:
    just render "{{out}}/beam_clamp_w{{full_wall}}_c{{full_clearance}}_L{{full_length}}.stl" \
        --wall {{full_wall}} --clearance {{full_clearance}} --length {{full_length}}

# Wrap phase 1: joint coupons over joint_clearance x tooth_h. Print each twice to get two mating pairs.
wrap-coupon:
    #!/usr/bin/env bash
    set -euo pipefail
    for jc in {{coupon_clearances}}; do
        for th in {{coupon_tooth_hs}}; do
            just render-wrap "{{out}}/wrap_coupon_w{{wrap_wall}}_jc${jc}_th${th}.stl" \
                --wall {{wrap_wall}} --clearance {{wrap_clearance}} --joint_clearance "$jc" \
                --tooth_h "$th" --length {{coupon_length}} --coupon 1 --label "jc$jc th$th"
        done
    done

# Wrap phase 2: one full-scale half (print two)
wrap:
    just render-wrap "{{out}}/beam_wrap_w{{wrap_wall}}_c{{wrap_clearance}}_jc{{wrap_joint_clearance}}_L{{wrap_length}}.stl" \
        --wall {{wrap_wall}} --clearance {{wrap_clearance}} --joint_clearance {{wrap_joint_clearance}} \
        --length {{wrap_length}}

# Bolt phase 1: joint coupons over joint_clearance. Print each twice to get two mating pairs.
bolt-coupon:
    #!/usr/bin/env bash
    set -euo pipefail
    for jc in {{bolt_clearances}}; do
        just render-bolt "{{out}}/bolt_coupon_w{{bolt_wall}}_jc${jc}.stl" \
            {{bolt_args}} --joint_clearance "$jc" --length {{bolt_coupon_length}} --coupon 1 --label "jc$jc"
    done

# Bolt phase 2: the hanger's two halves, full scale: lower with the rail clamps fused on, upper plain
bolt:
    just render-bolt "{{out}}/hanger_lower_w{{bolt_wall}}_c{{bolt_clearance}}_jc{{bolt_joint_clearance}}_L{{bolt_length}}.stl" \
        {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} --length {{bolt_length}} {{fused_args}} --bolt_slot 0
    just render-bolt "{{out}}/hanger_upper_w{{bolt_wall}}_c{{bolt_clearance}}_jc{{bolt_joint_clearance}}_L{{bolt_length}}.stl" \
        {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} --length {{bolt_length}}

# Flex phase 1: joint coupons over joint_clearance x tooth_h. Print each twice to get two mating pairs.
flex-coupon:
    #!/usr/bin/env bash
    set -euo pipefail
    for jc in {{flex_clearances}}; do
        for th in {{flex_tooth_hs}}; do
            just render-flex "{{out}}/flex_coupon_w{{flex_wall}}_jc${jc}_th${th}.stl" \
                {{flex_args}} --joint_clearance "$jc" --tooth_h "$th" --length {{flex_coupon_length}} --coupon 1 --label "jc$jc th$th"
        done
    done

# Flex phase 2: one full-scale flex half (print two)
flex:
    just render-flex "{{out}}/beam_flex_w{{flex_wall}}_c{{flex_clearance}}_jc{{flex_joint_clearance}}_L{{flex_length}}.stl" \
        {{flex_args}} --joint_clearance {{flex_joint_clearance}} --length {{flex_length}}

# Rail clamp fit coupons: single Cs for each tube section over wall x opening, a few mm long
rail_sweep_tubes := "outer inner"
rail-coupons:
    #!/usr/bin/env bash
    set -euo pipefail
    for t in {{rail_sweep_tubes}}; do
        for w in {{rail_sweep_walls}}; do
            for o in {{rail_sweep_openings}}; do
                just render-rail "{{out}}/rail_coupon_${t}_w${w}_o${o}_c{{rail_clearance}}_L{{rail_coupon_length}}.stl" \
                    --tubes "$t" --length {{rail_coupon_length}} --clearance {{rail_clearance}} --min_safety 0 \
                    --wall "$w" --opening "$o" --label "${t:0:1} w$w o$o" || echo "  skipped $t w$w o$o: does not validate"
            done
        done
    done

# The stand-alone rail clamp (plate version) with the values above
rail-clamp:
    just render-rail "{{out}}/rail_clamp_{{rails}}_s{{rail_spacing}}_w{{rail_wall}}_o{{rail_opening}}_c{{rail_clearance}}_L{{bolt_length}}.stl" \
        {{rail_args}} --wall {{rail_wall}} --opening {{rail_opening}} --length {{bolt_length}}

# --- Thin test run: the hanger's two halves at test_length, to check the beam fit and rail grip
test_length := "10"

# Lower halves (rail clamps fused on: one for the rails' outer section, one for the inner) and the upper half, test_length long, with IDs
test-run:
    just render-bolt "{{out}}/testrun_lower_{{rails}}_L{{test_length}}.stl" {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} \
        --length {{test_length}} {{fused_args}} --bolt_slot 0 --label "{{rails}} o{{rail_opening}}"
    just render-bolt "{{out}}/testrun_lower_inner,inner_L{{test_length}}.stl" {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} \
        --length {{test_length}} {{fused_args}} --rails inner,inner --bolt_slot 0 --label "inner o{{rail_opening}}"
    just render-bolt "{{out}}/testrun_upper_L{{test_length}}.stl" {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} \
        --length {{test_length}} --label "upper jc{{bolt_joint_clearance}}"

# Render everything
all: proto full wrap-coupon wrap bolt-coupon bolt flex-coupon flex rail-coupons rail-clamp

# Regenerate the drawings used by the README
preview:
    just render profile.svg
    just render-wrap wrap_profile.svg
    {{python}} -c "from beam_wrap import WrapParams, export_assembly_svg; export_assembly_svg(WrapParams(), 'wrap_assembly.svg')"
    just render-bolt bolt_profile.svg {{bolt_args}}
    {{python}} -c "from beam_bolt import BoltParams, export_assembly_svg; export_assembly_svg(BoltParams(), 'bolt_assembly.svg')"
    just render-flex flex_profile.svg {{flex_args}}
    {{python}} -c "from beam_flex import FlexParams, export_assembly_svg; export_assembly_svg(FlexParams(), 'flex_assembly.svg')"
    {{python}} framfusig.py -o rail_profiles.svg
    just render-rail rail_clamp_profile.svg {{rail_args}} --wall {{rail_wall}} --opening {{rail_opening}} --length {{bolt_length}}
    just render-bolt hanger_profile.svg {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} --length {{bolt_length}} {{fused_args}}

# Model each design assembled around a solid beam: STEP + STL + SVG views in assembly/
assembly:
    {{python}} assembly.py clamp
    {{python}} assembly.py wrap
    {{python}} assembly.py bolt {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} --length {{bolt_length}}
    {{python}} assembly.py flex {{flex_args}} --joint_clearance {{flex_joint_clearance}} --length {{flex_length}}
    {{python}} assembly.py hanger {{bolt_args}} --joint_clearance {{bolt_joint_clearance}} --length {{bolt_length}} {{fused_args}}

# Run the geometry tests
test:
    {{python}} -m pytest -q

# Delete rendered output
clean:
    rm -rf {{out}}
